{
  "repo_path": "C:/Dev/promohub",
  "branch": "dev/promohub-mobile-categories",
  "poll_seconds": 30,
  "upload_dir": "upload",
  "state_file": ".openboost-deploy-state.json",
  "backup_dir": ".deploy-backups",
  "allow_remote_delete": false,
  "health_url": "https://staging.example.com/",
  "health_timeout": 20,
  "ftp": {
    "host": "ftp.example.com",
    "port": 21,
    "user": "CHANGE_ME",
    "password_env": "OPENBOOST_FTP_PASSWORD",
    "tls": true,
    "remote_root": "/www"
  },
  "bridge": {
    "url": "https://staging.example.com/private-deploy/sitezilla_deploy_bridge.php",
    "secret_env": "OPENBOOST_DEPLOY_SECRET",
    "timeout": 90
  },
  "ocmod": {
    "canonical_code": "sitezilla_promo_hub",
    "status": 1,
    "installer_files": [
      "install.xml",
      "install.ocmod.xml"
    ],
    "legacy_code_regexes": [
      "^sitezilla_promo_hub_v?[0-9._-]+$",
      "^jako_promo_hub_v?[0-9._-]+$"
    ]
  },
  "cache_rules": {
    "templates": ["journal_templates"],
    "assets": ["journal_assets"],
    "php": []
  }
}
